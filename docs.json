          {
            "group": "Concepts",
            "icon": "lightbulb",
            "pages": [
              "github-action/concepts/how-it-works"
            ]
          },
          {
            "group": "Guides",
            "icon": "book-open",
            "pages": [
              "github-action/guides/running-in-ci",
              "github-action/guides/verifying-your-app",
              "github-action/guides/verification-platforms"
            ]
          },
          {
            "group": "Configuration",
            "icon": "settings",
            "pages": [
              "github-action/configuration/configuration"
            ]
          },
          {
            "group": "Advanced",
            "icon": "wrench",
            "pages": [
              "github-action/advanced/custom-configuration",
              "github-action/advanced/evidence",
              "github-action/advanced/diagnostics"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Dashboard",
