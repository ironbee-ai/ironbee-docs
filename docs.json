              }
            ]
          },
          {
            "group": "GitHub Action",
            "icon": "github",
            "pages": [
              "github-action/get-started/getting-started",
              "github-action/concepts/how-it-works",
              {
                "group": "Guides",
                "pages": [
                  "github-action/guides/running-in-ci",
                  "github-action/guides/verifying-your-app",
                  "github-action/guides/verification-platforms"
