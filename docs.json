          },
          {
            "group": "Findings",
            "icon": "triangle-alert",
            "pages": [
              "console/findings-account",
              "console/findings-project"
            ]
          },
          {
            "group": "Recommendations",
            "icon": "lightbulb",
            "pages": [
              "console/recommendations-account",
              "console/recommendations-project"
            ]
          },
          {
            "group": "Traces",
            "icon": "chart-bar",
            "pages": [
              "console/traces"
            ]
          },
          {
            "group": "Account & Team",
            "icon": "users",
            "pages": [
              "console/profile",
              "console/account",
              "console/team",
              "console/settings"
