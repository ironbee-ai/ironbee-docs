{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "IronBee",
  "description": "IronBee documentation — install the CLI, configure your projects, and explore the console.",
  "colors": {
    "primary": "#747c7f",
    "light": "#9fa1a4",
    "dark": "#0a0b0b"
  },
  "favicon": {
    "light": "/favicon-light.svg",
    "dark": "/favicon-dark.svg"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "width": 328
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": ["copy", "view", "assistant", "mcp", "add-mcp"]
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Home",
          "icon": "house",
          "href": "/"
        }
      ]
    },
    "directory": "card",
    "tabs": [
      {
        "tab": "Getting Started",
        "groups": [
          {
            "group": "Introduction",
            "icon": "rocket",
            "pages": [
              "getting-started/introduction",
              "getting-started/quickstart",
              "getting-started/key-concepts"
            ]
          }
        ]
      },
      {
        "tab": "CLI",
        "groups": [
          {
            "group": "Get Started",
            "icon": "rocket",
            "pages": [
              "cli/get-started/getting-started"
            ]
          },
          {
            "group": "Concepts",
            "icon": "lightbulb",
            "pages": [
              "cli/concepts/how-it-works"
            ]
          },
          {
            "group": "Guides",
            "icon": "book-open",
            "pages": [
              "cli/guides/managing-projects",
              "cli/guides/verification",
              "cli/guides/importing-sessions",
              "cli/guides/interactive-mode"
            ]
          },
          {
            "group": "Configuration",
            "icon": "settings",
            "pages": [
              "cli/configuration/configuration",
              "cli/configuration/environment-variables"
            ]
          },
          {
            "group": "Advanced",
            "icon": "wrench",
            "pages": [
              "cli/advanced/inspecting-sessions",
              "cli/advanced/job-queue",
              "cli/advanced/telemetry-statusline",
              "cli/advanced/runtime-files"
            ]
          },
          {
            "group": "AI Clients",
            "icon": "bot",
            "pages": [
              "cli/clients/claude-code",
              "cli/clients/cursor"
            ]
          }
        ]
      },
      {
        "tab": "Console",
        "groups": [
          {
            "group": "Projects",
            "icon": "layers",
            "pages": [
              "console/projects",
              "console/sessions",
              "console/session-details",
              "console/session-timeline",
              "console/session-analytics",
              "console/activities",
              "console/verifications",
              "console/verification-detail",
              "console/fixes",
              "console/fix-detail",
              "console/other"
            ]
          },
          {
            "group": "Analysis",
            "icon": "sparkles",
            "pages": [
              "console/analysis",
              {
                "group": "Account",
                "pages": [
                  "console/analysis-account-cost",
                  "console/analysis-account-session-insights"
                ]
              },
              {
                "group": "Project",
                "pages": [
                  "console/analysis-project-cost",
                  "console/analysis-project-session-insights",
                  "console/analysis-quality"
