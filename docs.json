{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "IronBee",
  "description": "IronBee is your AI QA engineer. It catches bugs before you ship. Connect GitHub, Vercel, or Netlify, or install the CLI, and follow every verification run in the console.",
  "colors": {
    "primary": "#0a0b0b",
    "light": "#f5f5f5",
    "dark": "#4a5159"
  },
  "favicon": {
    "light": "/favicon-light.svg",
    "dark": "/favicon-dark.svg"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "width": 328
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "assistant",
      "mcp",
      "add-mcp"
    ]
  },
