{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "IronBee",
  "description": "IronBee documentation — install the CLI, configure your projects, and explore the console.",
  "colors": {
    "primary": "#0a0b0b",
    "light": "#f5f5f5",
    "dark": "#4a5159"
  },
  "favicon": {
    "light": "/favicon-light.svg",
    "dark": "/favicon-dark.svg"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "width": 328
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": ["copy", "view", "assistant", "mcp", "add-mcp"]
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Home",
          "icon": "house",
          "href": "/"
        }
      ]
    },
    "directory": "card",
    "tabs": [
      {
        "tab": "Overview",
        "groups": [
          {
            "group": "Introduction",
            "icon": "rocket",
            "pages": [
              "getting-started/introduction",
              "getting-started/quickstart"
            ]
          },
          {
            "group": "Concepts",
            "icon": "lightbulb",
            "pages": [
              "getting-started/key-concepts"
            ]
          },
          {
            "group": "CLI",
            "icon": "terminal",
            "pages": [
              "cli/get-started/getting-started",
              {
                "group": "Guides",
                "pages": [
                  "cli/concepts/how-it-works",
                  "cli/guides/authentication",
                  "cli/guides/managing-projects",
                  "cli/guides/verification",
                  "cli/guides/verification-context",
                  "cli/guides/verification-jobs",
                  "cli/guides/scenarios",
                  "cli/guides/issue-tracking",
                  "cli/guides/importing-sessions",
                  "cli/guides/interactive-mode"
                ]
              },
              {
                "group": "Configuration",
                "pages": [
                  "cli/configuration/configuration",
                  "cli/configuration/environment-variables"
                ]
              },
              {
                "group": "Advanced",
                "pages": [
                  "cli/advanced/inspecting-sessions",
                  "cli/advanced/job-queue",
                  "cli/advanced/privacy",
                  "cli/advanced/telemetry-statusline",
                  "cli/advanced/runtime-files"
                ]
              },
              {
                "group": "AI Clients",
                "pages": [
                  "cli/clients/claude-code",
                  "cli/clients/cursor",
                  "cli/clients/codex"
